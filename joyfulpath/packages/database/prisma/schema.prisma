// This is the Prisma schema for JoyfulPath - Sunday School Gamified Learning Platform
// Docs: https://pris.ly/d/prisma-schema

generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "sqlite"
  url      = env("DATABASE_URL")
}

// ============================================
// Enums
// ============================================

// ============================================
// Models
// ============================================

model User {
  id             String    @id @default(uuid())
  username       String?   @unique
  email          String?   @unique
  passwordHash   String    @map("password_hash")
  pinHash        String?   @map("pin_hash")
  firstName      String    @map("first_name")
  lastName       String    @map("last_name")
  displayName    String    @map("display_name")
  avatarUrl      String?   @map("avatar_url")
  role           String    @default("student")
  locale         String    @default("ar")
  totalXp        Int       @default(0) @map("total_xp")
  totalPoints    Int       @default(0) @map("total_points")
  currentLevelId String?   @map("current_level_id")
  currentStreak  Int       @default(0) @map("current_streak")
  longestStreak  Int       @default(0) @map("longest_streak")
  lastActiveAt   DateTime? @map("last_active_at")
  isActive       Boolean   @default(true) @map("is_active")
  accountStatus  String    @default("pending") @map("account_status")
  churchId       String?   @map("church_id")
  branchId       String?   @map("branch_id")
  forcePasswordChange Boolean @default(true) @map("force_password_change")
  createdAt      DateTime  @default(now()) @map("created_at")
  updatedAt      DateTime  @default(now()) @updatedAt @map("updated_at")

  // Relations
  currentLevel            Level?                @relation(fields: [currentLevelId], references: [id])
  classMembers            ClassMember[]
  createdClasses          Class[]               @relation("ClassCreator")
  createdLessons          Lesson[]              @relation("LessonCreator")
  lessonProgress          LessonProgress[]
  attendanceRecords       Attendance[]          @relation("AttendanceStudent")
  recordedAttendance      Attendance[]          @relation("AttendanceRecorder")
  createdTasks            Task[]                @relation("TaskCreator")
  taskSubmissions         TaskSubmission[]      @relation("SubmissionStudent")
  reviewedSubmissions     TaskSubmission[]      @relation("SubmissionReviewer")
  createdQuizzes          Quiz[]                @relation("QuizCreator")
  quizAttempts            QuizAttempt[]
  pointsTransactions      PointsTransaction[]   @relation("PointsUser")
  awardedPoints           PointsTransaction[]   @relation("PointsAwarder")
  studentBadges           StudentBadge[]
  leaderboardEntries      LeaderboardEntry[]
  announcements           Announcement[]
  activityLogs            ActivityLog[]
  prayerRequests          PrayerRequest[]       @relation("PrayerStudent")
  addressedPrayerRequests PrayerRequest[]       @relation("PrayerAddressedBy")
  redemptions             RewardRedemption[]    @relation("RedemptionUser")
  reviewedRedemptions     RewardRedemption[]    @relation("RedemptionReviewer")
  studentAchievements     StudentAchievement[]  @relation("AchievementUser")
  awardedAchievements     StudentAchievement[]  @relation("AchievementAwarder")
  prayerResponses         PrayerResponse[]
  challengeProgresses     ChallengeProgress[]
  xpEntries               XpEntry[]
  notifications           Notification[]
  gameSessions            GameSession[]
  gameProgresses          GameProgress[]
  readingPlanProgresses   ReadingPlanProgress[]
  church                  Church?               @relation(fields: [churchId], references: [id])
  branch                  Branch?               @relation(fields: [branchId], references: [id])
  sentMessages            Message[]             @relation("MessageSender")
  receivedMessages        Message[]             @relation("MessageReceiver")
  studentNotes            StudentNote[]         @relation("NoteStudent")
  writtenNotes            StudentNote[]         @relation("NoteAuthor")
  followUpRecords         FollowUpRecord[]      @relation("FollowUpStudent")
  recordedFollowUps       FollowUpRecord[]      @relation("FollowUpRecorder")
  homeVisits              HomeVisit[]           @relation("VisitStudent")
  recordedHomeVisits      HomeVisit[]           @relation("VisitRecorder")
  phoneCalls              PhoneCall[]           @relation("CallStudent")
  recordedPhoneCalls      PhoneCall[]           @relation("CallRecorder")
  teamMemberships         TeamMember[]
  pets                    Pet[]
  avatarCustomizations    AvatarCustomization[]
  loginHistories          LoginHistory[]
  deviceSessions          DeviceSession[]
  memoryVerses            MemoryVerse[]
  verseRevisions          VerseRevision[]
  deletedAt               DateTime?             @map("deleted_at")

  @@map("users")
}

model Class {
  id           String   @id @default(uuid())
  name         String
  description  String?
  gradeLevel   String?  @map("grade_level")
  academicYear String   @map("academic_year")
  isActive     Boolean  @default(true) @map("is_active")
  maxStudents  Int      @default(30) @map("max_students")
  createdBy    String   @map("created_by")
  createdAt    DateTime @default(now()) @map("created_at")
  updatedAt    DateTime @default(now()) @updatedAt @map("updated_at")

  // Relations
  creator            User               @relation("ClassCreator", fields: [createdBy], references: [id])
  members            ClassMember[]
  lessons            Lesson[]
  attendance         Attendance[]
  tasks              Task[]
  quizzes            Quiz[]
  leaderboardEntries LeaderboardEntry[]
  announcements      Announcement[]
  prayerRequests     PrayerRequest[]
  deletedAt          DateTime?          @map("deleted_at")

  @@map("classes")
}

model ClassMember {
  id       String   @id @default(uuid())
  classId  String   @map("class_id")
  userId   String   @map("user_id")
  role     String
  joinedAt DateTime @default(now()) @map("joined_at")
  isActive Boolean  @default(true) @map("is_active")

  // Relations
  class Class @relation(fields: [classId], references: [id], onDelete: Cascade)
  user  User  @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([classId, userId])
  @@index([classId])
  @@index([userId])
  @@map("class_members")
}

model Lesson {
  id              String    @id @default(uuid())
  classId         String    @map("class_id")
  title           String
  description     String?
  content         String
  bibleReferences String    @default("[]") @map("bible_references")
  thumbnailUrl    String?   @map("thumbnail_url")
  xpReward        Int       @default(50) @map("xp_reward")
  pointsReward    Int       @default(10) @map("points_reward")
  orderIndex      Int       @default(0) @map("order_index")
  status          String    @default("draft")
  publishedAt     DateTime? @map("published_at")
  createdBy       String    @map("created_by")
  createdAt       DateTime  @default(now()) @map("created_at")
  updatedAt       DateTime  @default(now()) @updatedAt @map("updated_at")

  // Relations
  class       Class              @relation(fields: [classId], references: [id], onDelete: Cascade)
  creator     User               @relation("LessonCreator", fields: [createdBy], references: [id])
  attachments LessonAttachment[]
  progress    LessonProgress[]
  tasks       Task[]
  quizzes     Quiz[]
  deletedAt   DateTime?          @map("deleted_at")

  @@index([classId])
  @@index([status])
  @@map("lessons")
}

model LessonAttachment {
  id         String   @id @default(uuid())
  lessonId   String   @map("lesson_id")
  fileName   String   @map("file_name")
  fileUrl    String   @map("file_url")
  fileType   String   @map("file_type")
  fileSize   Int      @map("file_size")
  uploadedAt DateTime @default(now()) @map("uploaded_at")

  // Relations
  lesson Lesson @relation(fields: [lessonId], references: [id], onDelete: Cascade)

  @@map("lesson_attachments")
}

model LessonProgress {
  id          String    @id @default(uuid())
  lessonId    String    @map("lesson_id")
  userId      String    @map("user_id")
  status      String    @default("not_started")
  startedAt   DateTime? @map("started_at")
  completedAt DateTime? @map("completed_at")
  progressPct Int       @default(0) @map("progress_pct")

  // Relations
  lesson Lesson @relation(fields: [lessonId], references: [id], onDelete: Cascade)
  user   User   @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([lessonId, userId])
  @@map("lesson_progress")
}

model Attendance {
  id         String   @id @default(uuid())
  classId    String   @map("class_id")
  userId     String   @map("user_id")
  date       DateTime
  status     String
  recordedBy String   @map("recorded_by")
  notes      String?
  xpAwarded  Int      @default(0) @map("xp_awarded")
  createdAt  DateTime @default(now()) @map("created_at")

  // Relations
  class    Class @relation(fields: [classId], references: [id], onDelete: Cascade)
  student  User  @relation("AttendanceStudent", fields: [userId], references: [id])
  recorder User  @relation("AttendanceRecorder", fields: [recordedBy], references: [id])

  @@unique([classId, userId, date])
  @@index([classId, date])
  @@index([userId])
  @@map("attendance")
}

model Task {
  id             String    @id @default(uuid())
  classId        String    @map("class_id")
  lessonId       String?   @map("lesson_id")
  title          String
  description    String
  taskType       String    @map("task_type")
  xpReward       Int       @default(30) @map("xp_reward")
  pointsReward   Int       @default(5) @map("points_reward")
  dueDate        DateTime? @map("due_date")
  maxSubmissions Int       @default(0) @map("max_submissions")
  allowLate      Boolean   @default(false) @map("allow_late")
  status         String    @default("draft")
  createdBy      String    @map("created_by")
  createdAt      DateTime  @default(now()) @map("created_at")
  updatedAt      DateTime  @default(now()) @updatedAt @map("updated_at")

  // Relations
  class       Class            @relation(fields: [classId], references: [id], onDelete: Cascade)
  lesson      Lesson?          @relation(fields: [lessonId], references: [id])
  creator     User             @relation("TaskCreator", fields: [createdBy], references: [id])
  submissions TaskSubmission[]
  deletedAt   DateTime?        @map("deleted_at")

  @@map("tasks")
}

model TaskSubmission {
  id            String    @id @default(uuid())
  taskId        String    @map("task_id")
  studentId     String    @map("student_id")
  content       String?
  attachmentUrl String?   @map("attachment_url")
  status        String    @default("pending")
  feedback      String?
  reviewedBy    String?   @map("reviewed_by")
  reviewedAt    DateTime? @map("reviewed_at")
  xpAwarded     Int       @default(0) @map("xp_awarded")
  pointsAwarded Int       @default(0) @map("points_awarded")
  submittedAt   DateTime  @default(now()) @map("submitted_at")
  attemptNumber Int       @default(0) @map("attempt_number")

  // Relations
  task     Task  @relation(fields: [taskId], references: [id], onDelete: Cascade)
  student  User  @relation("SubmissionStudent", fields: [studentId], references: [id])
  reviewer User? @relation("SubmissionReviewer", fields: [reviewedBy], references: [id])

  @@index([taskId])
  @@index([studentId])
  @@index([status])
  @@map("task_submissions")
}

model Quiz {
  id               String    @id @default(uuid())
  classId          String    @map("class_id")
  lessonId         String?   @map("lesson_id")
  title            String
  description      String?
  quizType         String    @map("quiz_type")
  timeLimitSeconds Int?      @map("time_limit_seconds")
  maxAttempts      Int       @default(3) @map("max_attempts")
  passingScore     Int       @default(70) @map("passing_score")
  xpReward         Int       @default(50) @map("xp_reward")
  pointsReward     Int       @default(10) @map("points_reward")
  shuffleQuestions Boolean   @default(true) @map("shuffle_questions")
  showAnswersAfter Boolean   @default(true) @map("show_answers_after")
  status           String    @default("draft")
  availableFrom    DateTime? @map("available_from")
  availableUntil   DateTime? @map("available_until")
  createdBy        String    @map("created_by")
  createdAt        DateTime  @default(now()) @map("created_at")

  // Relations
  class     Class         @relation(fields: [classId], references: [id], onDelete: Cascade)
  lesson    Lesson?       @relation(fields: [lessonId], references: [id])
  creator   User          @relation("QuizCreator", fields: [createdBy], references: [id])
  questions Question[]
  attempts  QuizAttempt[]
  deletedAt DateTime?     @map("deleted_at")

  @@map("quizzes")
}

model Question {
  id               String  @id @default(uuid())
  quizId           String  @map("quiz_id")
  questionType     String  @map("question_type")
  questionText     String  @map("question_text")
  questionImageUrl String? @map("question_image_url")
  bibleReference   String? @map("bible_reference")
  pointsValue      Int     @default(10) @map("points_value")
  orderIndex       Int     @default(0) @map("order_index")
  explanation      String?

  // Relations
  quiz    Quiz     @relation(fields: [quizId], references: [id], onDelete: Cascade)
  answers Answer[]

  @@map("questions")
}

model Answer {
  id         String  @id @default(uuid())
  questionId String  @map("question_id")
  answerText String  @map("answer_text")
  isCorrect  Boolean @default(false) @map("is_correct")
  orderIndex Int     @default(0) @map("order_index")

  // Relations
  question Question @relation(fields: [questionId], references: [id], onDelete: Cascade)

  @@map("answers")
}

model QuizAttempt {
  id               String   @id @default(uuid())
  quizId           String   @map("quiz_id")
  studentId        String   @map("student_id")
  score            Int
  totalPossible    Int      @map("total_possible")
  percentage       Decimal
  passed           Boolean
  timeTakenSeconds Int?     @map("time_taken_seconds")
  answersSnapshot  String   @map("answers_snapshot")
  xpAwarded        Int      @default(0) @map("xp_awarded")
  pointsAwarded    Int      @default(0) @map("points_awarded")
  attemptNumber    Int      @map("attempt_number")
  startedAt        DateTime @map("started_at")
  completedAt      DateTime @map("completed_at")

  // Relations
  quiz    Quiz @relation(fields: [quizId], references: [id], onDelete: Cascade)
  student User @relation(fields: [studentId], references: [id])

  @@index([studentId, quizId])
  @@map("quiz_attempts")
}

model PointsTransaction {
  id          String   @id @default(uuid())
  userId      String   @map("user_id")
  amount      Int
  type        String
  source      String
  sourceId    String?  @map("source_id")
  description String
  awardedBy   String?  @map("awarded_by")
  createdAt   DateTime @default(now()) @map("created_at")

  // Relations
  user    User  @relation("PointsUser", fields: [userId], references: [id])
  awarder User? @relation("PointsAwarder", fields: [awardedBy], references: [id])

  @@index([userId])
  @@index([createdAt])
  @@index([source])
  @@map("points_transactions")
}

model Level {
  id          String  @id @default(uuid())
  levelNumber Int     @unique @map("level_number")
  title       String
  titleAr     String? @map("title_ar")
  minXp       Int     @map("min_xp")
  maxXp       Int     @map("max_xp")
  iconUrl     String? @map("icon_url")
  color       String?

  // Relations
  users User[]

  @@map("levels")
}

model Badge {
  id             String   @id @default(uuid())
  name           String
  nameAr         String?  @map("name_ar")
  description    String
  descriptionAr  String?  @map("description_ar")
  iconUrl        String   @map("icon_url")
  category       String
  criteriaType   String   @map("criteria_type")
  criteriaValue  Int?     @map("criteria_value")
  criteriaConfig String   @default("{}") @map("criteria_config")
  xpBonus        Int      @default(0) @map("xp_bonus")
  pointsBonus    Int      @default(0) @map("points_bonus")
  rarity         String   @default("common")
  isActive       Boolean  @default(true) @map("is_active")
  createdAt      DateTime @default(now()) @map("created_at")

  // Relations
  studentBadges StudentBadge[]

  @@map("badges")
}

model StudentBadge {
  id        String   @id @default(uuid())
  userId    String   @map("user_id")
  badgeId   String   @map("badge_id")
  earnedAt  DateTime @default(now()) @map("earned_at")
  displayed Boolean  @default(false)

  // Relations
  user  User  @relation(fields: [userId], references: [id], onDelete: Cascade)
  badge Badge @relation(fields: [badgeId], references: [id], onDelete: Cascade)

  @@unique([userId, badgeId])
  @@map("student_badges")
}

model LeaderboardEntry {
  id          String   @id @default(uuid())
  userId      String   @map("user_id")
  classId     String?  @map("class_id")
  period      String
  periodStart DateTime @map("period_start")
  totalXp     Int      @default(0) @map("total_xp")
  rank        Int?
  rankChange  Int      @default(0) @map("rank_change")
  updatedAt   DateTime @default(now()) @updatedAt @map("updated_at")

  // Relations
  user  User   @relation(fields: [userId], references: [id], onDelete: Cascade)
  class Class? @relation(fields: [classId], references: [id], onDelete: Cascade)

  @@unique([userId, classId, period, periodStart])
  @@index([classId, period, periodStart])
  @@map("leaderboard_entries")
}

model Announcement {
  id          String    @id @default(uuid())
  classId     String?   @map("class_id")
  authorId    String    @map("author_id")
  title       String
  content     String
  priority    String    @default("normal")
  isPinned    Boolean   @default(false) @map("is_pinned")
  publishedAt DateTime  @default(now()) @map("published_at")
  expiresAt   DateTime? @map("expires_at")
  createdAt   DateTime  @default(now()) @map("created_at")

  // Relations
  class     Class?    @relation(fields: [classId], references: [id], onDelete: Cascade)
  author    User      @relation(fields: [authorId], references: [id])
  deletedAt DateTime? @map("deleted_at")

  @@map("announcements")
}

model ActivityLog {
  id           String   @id @default(uuid())
  userId       String   @map("user_id")
  action       String
  entityType   String   @map("entity_type")
  entityId     String?  @map("entity_id")
  metadata     String   @default("{}")
  xpChange     Int      @default(0) @map("xp_change")
  pointsChange Int      @default(0) @map("points_change")
  createdAt    DateTime @default(now()) @map("created_at")

  // Relations
  user User @relation(fields: [userId], references: [id])

  @@index([userId, createdAt(sort: Desc)])
  @@map("activity_log")
}

// ============================================
// Phase 2 & 3 Additions
// ============================================

model PrayerRequest {
  id          String    @id @default(uuid())
  studentId   String    @map("student_id")
  classId     String?   @map("class_id")
  type        String
  title       String?
  body        String
  isPrivate   Boolean   @default(false) @map("is_private")
  isAddressed Boolean   @default(false) @map("is_addressed")
  addressedBy String?   @map("addressed_by")
  addressedAt DateTime? @map("addressed_at")
  createdAt   DateTime  @default(now()) @map("created_at")
  updatedAt   DateTime  @default(now()) @updatedAt @map("updated_at")

  // Relations
  student         User             @relation("PrayerStudent", fields: [studentId], references: [id], onDelete: Cascade)
  class           Class?           @relation(fields: [classId], references: [id], onDelete: Cascade)
  addressedByUser User?            @relation("PrayerAddressedBy", fields: [addressedBy], references: [id])
  responses       PrayerResponse[]

  @@index([studentId])
  @@index([classId])
  @@map("prayer_requests")
}

model PrayerResponse {
  id              String   @id @default(uuid())
  prayerRequestId String   @map("prayer_request_id")
  responderId     String   @map("responder_id")
  message         String
  createdAt       DateTime @default(now()) @map("created_at")

  prayerRequest PrayerRequest @relation(fields: [prayerRequestId], references: [id], onDelete: Cascade)
  responder     User          @relation(fields: [responderId], references: [id])

  @@map("prayer_responses")
}

model Reward {
  id             String   @id @default(uuid())
  title          String
  description    String?
  type           String
  metadata       String   @default("{}")
  costXp         Int      @default(0) @map("cost_xp")
  inventoryCount Int?     @map("inventory_count")
  isActive       Boolean  @default(true) @map("is_active")
  createdAt      DateTime @default(now()) @map("created_at")

  redemptions RewardRedemption[]
  deletedAt   DateTime?          @map("deleted_at")

  @@map("rewards")
}

model RewardRedemption {
  id           String    @id @default(uuid())
  userId       String    @map("user_id")
  rewardId     String    @map("reward_id")
  status       String    @default("pending")
  requestedAt  DateTime  @default(now()) @map("requested_at")
  reviewedBy   String?   @map("reviewed_by")
  reviewedAt   DateTime? @map("reviewed_at")
  shippingInfo String?   @map("shipping_info")
  notes        String?

  user     User   @relation("RedemptionUser", fields: [userId], references: [id], onDelete: Cascade)
  reward   Reward @relation(fields: [rewardId], references: [id], onDelete: Cascade)
  reviewer User?  @relation("RedemptionReviewer", fields: [reviewedBy], references: [id])

  @@index([userId])
  @@index([rewardId])
  @@map("reward_redemptions")
}

model Achievement {
  id           String   @id @default(uuid())
  key          String   @unique
  title        String
  description  String
  category     String
  criteria     String   @default("{}")
  xpReward     Int      @default(0) @map("xp_reward")
  pointsReward Int      @default(0) @map("points_reward")
  createdAt    DateTime @default(now()) @map("created_at")

  studentAchievements StudentAchievement[]

  @@map("achievements")
}

model StudentAchievement {
  id            String   @id @default(uuid())
  userId        String   @map("user_id")
  achievementId String   @map("achievement_id")
  earnedAt      DateTime @default(now()) @map("earned_at")
  progress      String   @default("{}")
  awardedBy     String?  @map("awarded_by")

  user        User        @relation("AchievementUser", fields: [userId], references: [id], onDelete: Cascade)
  achievement Achievement @relation(fields: [achievementId], references: [id], onDelete: Cascade)
  awarder     User?       @relation("AchievementAwarder", fields: [awardedBy], references: [id])

  @@unique([userId, achievementId])
  @@map("student_achievements")
}

model Challenge {
  id        String    @id @default(uuid())
  title     String
  scope     String
  startAt   DateTime? @map("start_at")
  endAt     DateTime? @map("end_at")
  rules     String    @default("{}")
  rewards   String    @default("{}")
  isActive  Boolean   @default(true) @map("is_active")
  createdAt DateTime  @default(now()) @map("created_at")

  progresses ChallengeProgress[]

  @@map("challenges")
}

model ChallengeProgress {
  id          String    @id @default(uuid())
  challengeId String    @map("challenge_id")
  userId      String    @map("user_id")
  progress    String    @default("{}")
  completed   Boolean   @default(false)
  completedAt DateTime? @map("completed_at")

  challenge Challenge @relation(fields: [challengeId], references: [id], onDelete: Cascade)
  user      User      @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([challengeId, userId])
  @@map("challenge_progress")
}

model XpEntry {
  id        String   @id @default(uuid())
  userId    String   @map("user_id")
  source    String?  @map("source")
  sourceId  String?  @map("source_id")
  xpAmount  Int      @map("xp_amount")
  createdAt DateTime @default(now()) @map("created_at")

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
  @@map("xp_entries")
}

model Notification {
  id        String    @id @default(uuid())
  userId    String    @map("user_id")
  channel   String
  type      String
  payload   String    @default("{}")
  readAt    DateTime?
  createdAt DateTime  @default(now()) @map("created_at")

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId, createdAt])
  @@map("notifications")
}

model GameSession {
  id         String    @id @default(uuid())
  gameType   String
  status     String    @default("active")
  hostUserId String?   @map("host_user_id")
  state      String    @default("{}")
  score      Int?      @default(0)
  startedAt  DateTime? @map("started_at")
  endedAt    DateTime? @map("ended_at")

  hostUser       User?          @relation(fields: [hostUserId], references: [id])
  gameProgresses GameProgress[]

  @@map("game_sessions")
}

model GameProgress {
  id         String   @id @default(uuid())
  sessionId  String   @map("session_id")
  userId     String   @map("user_id")
  checkpoint String   @default("{}")
  score      Int      @default(0)
  updatedAt  DateTime @default(now()) @updatedAt @map("updated_at")

  session GameSession @relation(fields: [sessionId], references: [id], onDelete: Cascade)
  user    User        @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([sessionId])
  @@index([userId])
  @@map("game_progress")
}

model ReadingPlanProgress {
  id        String   @id @default(uuid())
  userId    String   @map("user_id")
  planId    String   @map("plan_id")
  progress  String   @default("{}")
  streak    Int      @default(0)
  updatedAt DateTime @default(now()) @updatedAt @map("updated_at")

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([userId, planId])
  @@map("reading_plan_progress")
}

// ============================================
// Phase 4+ Additions (Massive Feature Expansion)
// ============================================

model Church {
  id          String   @id @default(uuid())
  name        String
  address     String?
  contactInfo String?  @map("contact_info")
  isActive    Boolean  @default(true) @map("is_active")
  createdAt   DateTime @default(now()) @map("created_at")

  branches Branch[]
  users    User[]

  @@map("churches")
}

model Branch {
  id          String   @id @default(uuid())
  churchId    String   @map("church_id")
  name        String
  location    String?
  contactInfo String?  @map("contact_info")
  isActive    Boolean  @default(true) @map("is_active")
  createdAt   DateTime @default(now()) @map("created_at")

  church Church @relation(fields: [churchId], references: [id], onDelete: Cascade)
  users  User[]

  @@index([churchId])
  @@map("branches")
}

model Saint {
  id        String    @id @default(uuid())
  name      String
  nameAr    String?   @map("name_ar")
  title     String?
  bio       String
  bioAr     String?   @map("bio_ar")
  iconUrl   String?   @map("icon_url")
  feastDay  DateTime? @map("feast_day")
  createdAt DateTime  @default(now()) @map("created_at")

  @@map("saints")
}

model Feast {
  id          String   @id @default(uuid())
  name        String
  nameAr      String?  @map("name_ar")
  date        DateTime
  description String?
  isMajor     Boolean  @default(false) @map("is_major")
  createdAt   DateTime @default(now()) @map("created_at")

  @@map("feasts")
}

model Fast {
  id          String   @id @default(uuid())
  name        String
  nameAr      String?  @map("name_ar")
  startDate   DateTime @map("start_date")
  endDate     DateTime @map("end_date")
  description String?
  createdAt   DateTime @default(now()) @map("created_at")

  @@map("fasts")
}

model Synaxarium {
  id         String   @id @default(uuid())
  copticDate String   @map("coptic_date")
  title      String
  titleAr    String?  @map("title_ar")
  content    String
  contentAr  String?  @map("content_ar")
  createdAt  DateTime @default(now()) @map("created_at")

  @@map("synaxarium")
}

model DailyReading {
  id        String   @id @default(uuid())
  date      DateTime
  matins    String?
  vespers   String?
  liturgy   String?
  gospel    String?
  createdAt DateTime @default(now()) @map("created_at")

  @@map("daily_readings")
}

model ReadingPlan {
  id           String   @id @default(uuid())
  title        String
  description  String?
  durationDays Int      @map("duration_days")
  content      String   @default("[]")
  createdAt    DateTime @default(now()) @map("created_at")

  @@map("reading_plans")
}

model MemoryVerse {
  id          String   @id @default(uuid())
  userId      String   @map("user_id")
  verseText   String   @map("verse_text")
  reference   String
  isMemorized Boolean  @default(false) @map("is_memorized")
  createdAt   DateTime @default(now()) @map("created_at")

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
  @@map("memory_verses")
}

model VerseRevision {
  id        String   @id @default(uuid())
  userId    String   @map("user_id")
  verseId   String   @map("verse_id")
  score     Int      @default(0)
  revisedAt DateTime @default(now()) @map("revised_at")

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId, verseId])
  @@map("verse_revisions")
}

model MessageThread {
  id        String   @id @default(uuid())
  subject   String?
  createdAt DateTime @default(now()) @map("created_at")
  updatedAt DateTime @default(now()) @updatedAt @map("updated_at")

  messages Message[]

  @@map("message_threads")
}

model Message {
  id         String   @id @default(uuid())
  threadId   String   @map("thread_id")
  senderId   String   @map("sender_id")
  receiverId String   @map("receiver_id")
  content    String
  isRead     Boolean  @default(false) @map("is_read")
  createdAt  DateTime @default(now()) @map("created_at")

  thread   MessageThread @relation(fields: [threadId], references: [id], onDelete: Cascade)
  sender   User          @relation("MessageSender", fields: [senderId], references: [id])
  receiver User          @relation("MessageReceiver", fields: [receiverId], references: [id])

  @@index([threadId])
  @@index([senderId])
  @@index([receiverId])
  @@map("messages")
}

model StudentNote {
  id        String   @id @default(uuid())
  studentId String   @map("student_id")
  authorId  String   @map("author_id")
  content   String
  isPrivate Boolean  @default(true) @map("is_private")
  createdAt DateTime @default(now()) @map("created_at")

  student User @relation("NoteStudent", fields: [studentId], references: [id], onDelete: Cascade)
  author  User @relation("NoteAuthor", fields: [authorId], references: [id])

  @@index([studentId])
  @@map("student_notes")
}

model FollowUpRecord {
  id         String   @id @default(uuid())
  studentId  String   @map("student_id")
  recordedBy String   @map("recorded_by")
  method     String
  outcome    String
  followedAt DateTime @default(now()) @map("followed_at")

  student  User @relation("FollowUpStudent", fields: [studentId], references: [id], onDelete: Cascade)
  recorder User @relation("FollowUpRecorder", fields: [recordedBy], references: [id])

  @@index([studentId])
  @@map("follow_up_records")
}

model HomeVisit {
  id         String   @id @default(uuid())
  studentId  String   @map("student_id")
  recordedBy String   @map("recorded_by")
  notes      String
  visitedAt  DateTime @default(now()) @map("visited_at")

  student  User @relation("VisitStudent", fields: [studentId], references: [id], onDelete: Cascade)
  recorder User @relation("VisitRecorder", fields: [recordedBy], references: [id])

  @@index([studentId])
  @@map("home_visits")
}

model PhoneCall {
  id         String   @id @default(uuid())
  studentId  String   @map("student_id")
  recordedBy String   @map("recorded_by")
  duration   Int?     @map("duration_seconds")
  notes      String
  calledAt   DateTime @default(now()) @map("called_at")

  student  User @relation("CallStudent", fields: [studentId], references: [id], onDelete: Cascade)
  recorder User @relation("CallRecorder", fields: [recordedBy], references: [id])

  @@index([studentId])
  @@map("phone_calls")
}

model Team {
  id          String   @id @default(uuid())
  name        String
  description String?
  score       Int      @default(0)
  createdAt   DateTime @default(now()) @map("created_at")

  members TeamMember[]

  @@map("teams")
}

model TeamMember {
  id       String   @id @default(uuid())
  teamId   String   @map("team_id")
  userId   String   @map("user_id")
  joinedAt DateTime @default(now()) @map("joined_at")

  team Team @relation(fields: [teamId], references: [id], onDelete: Cascade)
  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([teamId, userId])
  @@map("team_members")
}

model Pet {
  id        String   @id @default(uuid())
  userId    String   @map("user_id")
  name      String
  type      String
  level     Int      @default(0)
  xp        Int      @default(0)
  createdAt DateTime @default(now()) @map("created_at")

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
  @@map("pets")
}

model AvatarCustomization {
  id         String   @id @default(uuid())
  userId     String   @map("user_id")
  itemType   String   @map("item_type")
  itemId     String   @map("item_id")
  equipped   Boolean  @default(false)
  acquiredAt DateTime @default(now()) @map("acquired_at")

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
  @@map("avatar_customizations")
}

model AuditLog {
  id        String   @id @default(uuid())
  action    String
  actorId   String?  @map("actor_id")
  entity    String
  entityId  String?  @map("entity_id")
  details   String   @default("{}")
  ipAddress String?  @map("ip_address")
  createdAt DateTime @default(now()) @map("created_at")

  @@index([actorId, createdAt])
  @@map("audit_logs")
}

model LoginHistory {
  id        String   @id @default(uuid())
  userId    String   @map("user_id")
  ipAddress String?  @map("ip_address")
  userAgent String?  @map("user_agent")
  success   Boolean  @default(true)
  loginAt   DateTime @default(now()) @map("login_at")

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
  @@map("login_history")
}

model DeviceSession {
  id          String   @id @default(uuid())
  userId      String   @map("user_id")
  deviceToken String   @unique @map("device_token")
  deviceInfo  String   @default("{}") @map("device_info")
  isActive    Boolean  @default(true) @map("is_active")
  lastSeenAt  DateTime @default(now()) @map("last_seen_at")

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
  @@map("device_sessions")
}
