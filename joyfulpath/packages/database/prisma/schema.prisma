// This is the Prisma schema for JoyfulPath - Sunday School Gamified Learning Platform
// Docs: https://pris.ly/d/prisma-schema

generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
}

// ============================================
// Enums
// ============================================

enum UserRole {
  admin
  instructor
  student
  parent
}

enum AccountStatus {
  pending
  active
  suspended
}

enum LessonStatus {
  draft
  published
  archived
}

enum LessonProgressStatus {
  not_started
  in_progress
  completed
}

enum AttendanceStatus {
  present
  absent
  late
  excused
}

enum TaskType {
  homework
  memorization
  activity
  reading
}

enum TaskStatus {
  draft
  active
  closed
}

enum SubmissionStatus {
  pending
  approved
  rejected
  revision_requested
}

enum QuizType {
  lesson_review
  weekly
  challenge
  practice
}

enum QuestionType {
  multiple_choice
  true_false
  verse_completion
  short_answer
}

enum PointsType {
  xp
  points
}

enum PointsSource {
  lesson
  quiz
  task
  attendance
  badge
  manual
  redemption
  streak_bonus
}

enum BadgeCategory {
  attendance
  lesson
  quiz
  social
  special
  streak
}

enum BadgeCriteriaType {
  count
  streak
  score
  manual
}

enum BadgeRarity {
  common
  uncommon
  rare
  epic
  legendary
}

enum LeaderboardPeriod {
  weekly
  monthly
  all_time
}

enum AnnouncementPriority {
  low
  normal
  high
  urgent
}

// ============================================
// Models
// ============================================

model User {
  id             String    @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  username       String?   @unique @db.VarChar(50)
  email          String?   @unique @db.VarChar(255)
  passwordHash   String    @map("password_hash") @db.VarChar(255)
  pinHash        String?   @map("pin_hash") @db.VarChar(255)
  firstName      String    @map("first_name") @db.VarChar(100)
  lastName       String    @map("last_name") @db.VarChar(100)
  displayName    String    @map("display_name") @db.VarChar(100)
  avatarUrl      String?   @map("avatar_url") @db.Text
  role           UserRole  @default(student)
  locale         String    @default("ar") @db.VarChar(5)
  totalXp        Int       @default(0) @map("total_xp")
  totalPoints    Int       @default(0) @map("total_points")
  currentLevelId String?   @map("current_level_id") @db.Uuid
  currentStreak  Int       @default(0) @map("current_streak")
  longestStreak  Int       @default(0) @map("longest_streak")
  lastActiveAt   DateTime? @map("last_active_at") @db.Timestamptz()
  isActive       Boolean       @default(true) @map("is_active")
  accountStatus  AccountStatus @default(pending) @map("account_status")
  churchId       String?       @map("church_id") @db.Uuid
  branchId       String?       @map("branch_id") @db.Uuid
  createdAt      DateTime      @default(now()) @map("created_at") @db.Timestamptz()
  updatedAt      DateTime  @default(now()) @updatedAt @map("updated_at") @db.Timestamptz()

  // Relations
  currentLevel            Level?                @relation(fields: [currentLevelId], references: [id])
  classMembers            ClassMember[]
  createdClasses          Class[]               @relation("ClassCreator")
  createdLessons          Lesson[]              @relation("LessonCreator")
  lessonProgress          LessonProgress[]
  attendanceRecords       Attendance[]          @relation("AttendanceStudent")
  recordedAttendance      Attendance[]          @relation("AttendanceRecorder")
  createdTasks            Task[]                @relation("TaskCreator")
  taskSubmissions         TaskSubmission[]      @relation("SubmissionStudent")
  reviewedSubmissions     TaskSubmission[]      @relation("SubmissionReviewer")
  createdQuizzes          Quiz[]                @relation("QuizCreator")
  quizAttempts            QuizAttempt[]
  pointsTransactions      PointsTransaction[]   @relation("PointsUser")
  awardedPoints           PointsTransaction[]   @relation("PointsAwarder")
  studentBadges           StudentBadge[]
  leaderboardEntries      LeaderboardEntry[]
  announcements           Announcement[]
  activityLogs            ActivityLog[]
  prayerRequests          PrayerRequest[]       @relation("PrayerStudent")
  addressedPrayerRequests PrayerRequest[]       @relation("PrayerAddressedBy")
  redemptions             RewardRedemption[]    @relation("RedemptionUser")
  reviewedRedemptions     RewardRedemption[]    @relation("RedemptionReviewer")
  studentAchievements     StudentAchievement[]  @relation("AchievementUser")
  awardedAchievements     StudentAchievement[]  @relation("AchievementAwarder")
  prayerResponses         PrayerResponse[]
  challengeProgresses     ChallengeProgress[]
  xpEntries               XpEntry[]
  notifications           Notification[]
  gameSessions            GameSession[]
  gameProgresses          GameProgress[]
  readingPlanProgresses   ReadingPlanProgress[]
  church                  Church?               @relation(fields: [churchId], references: [id])
  branch                  Branch?               @relation(fields: [branchId], references: [id])
  sentMessages            Message[]             @relation("MessageSender")
  receivedMessages        Message[]             @relation("MessageReceiver")
  studentNotes            StudentNote[]         @relation("NoteStudent")
  writtenNotes            StudentNote[]         @relation("NoteAuthor")
  followUpRecords         FollowUpRecord[]      @relation("FollowUpStudent")
  recordedFollowUps       FollowUpRecord[]      @relation("FollowUpRecorder")
  homeVisits              HomeVisit[]           @relation("VisitStudent")
  recordedHomeVisits      HomeVisit[]           @relation("VisitRecorder")
  phoneCalls              PhoneCall[]           @relation("CallStudent")
  recordedPhoneCalls      PhoneCall[]           @relation("CallRecorder")
  teamMemberships         TeamMember[]
  pets                    Pet[]
  avatarCustomizations    AvatarCustomization[]
  loginHistories          LoginHistory[]
  deviceSessions          DeviceSession[]
  memoryVerses            MemoryVerse[]
  verseRevisions          VerseRevision[]

  @@map("users")
  deletedAt      DateTime? @map("deleted_at") @db.Timestamptz()
}

model Class {
  id           String   @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  name         String   @db.VarChar(200)
  description  String?  @db.Text
  gradeLevel   String?  @map("grade_level") @db.VarChar(50)
  academicYear String   @map("academic_year") @db.VarChar(20)
  isActive     Boolean  @default(true) @map("is_active")
  maxStudents  Int      @default(30) @map("max_students")
  createdBy    String   @map("created_by") @db.Uuid
  createdAt    DateTime @default(now()) @map("created_at") @db.Timestamptz()
  updatedAt    DateTime @default(now()) @updatedAt @map("updated_at") @db.Timestamptz()

  // Relations
  creator            User               @relation("ClassCreator", fields: [createdBy], references: [id])
  members            ClassMember[]
  lessons            Lesson[]
  attendance         Attendance[]
  tasks              Task[]
  quizzes            Quiz[]
  leaderboardEntries LeaderboardEntry[]
  announcements      Announcement[]
  prayerRequests     PrayerRequest[]

  @@map("classes")
  deletedAt      DateTime? @map("deleted_at") @db.Timestamptz()
}

model ClassMember {
  id       String   @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  classId  String   @map("class_id") @db.Uuid
  userId   String   @map("user_id") @db.Uuid
  role     UserRole
  joinedAt DateTime @default(now()) @map("joined_at") @db.Timestamptz()
  isActive Boolean  @default(true) @map("is_active")

  // Relations
  class Class @relation(fields: [classId], references: [id], onDelete: Cascade)
  user  User  @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([classId, userId])
  @@index([classId])
  @@index([userId])
  @@map("class_members")
}

model Lesson {
  id              String       @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  classId         String       @map("class_id") @db.Uuid
  title           String       @db.VarChar(300)
  description     String?      @db.Text
  content         String       @db.Text
  bibleReferences Json         @default("[]") @map("bible_references") @db.JsonB
  thumbnailUrl    String?      @map("thumbnail_url") @db.Text
  xpReward        Int          @default(50) @map("xp_reward")
  pointsReward    Int          @default(10) @map("points_reward")
  orderIndex      Int          @default(0) @map("order_index")
  status          LessonStatus @default(draft)
  publishedAt     DateTime?    @map("published_at") @db.Timestamptz()
  createdBy       String       @map("created_by") @db.Uuid
  createdAt       DateTime     @default(now()) @map("created_at") @db.Timestamptz()
  updatedAt       DateTime     @default(now()) @updatedAt @map("updated_at") @db.Timestamptz()

  // Relations
  class       Class              @relation(fields: [classId], references: [id], onDelete: Cascade)
  creator     User               @relation("LessonCreator", fields: [createdBy], references: [id])
  attachments LessonAttachment[]
  progress    LessonProgress[]
  tasks       Task[]
  quizzes     Quiz[]

  @@index([classId])
  @@index([status])
  @@map("lessons")
  deletedAt      DateTime? @map("deleted_at") @db.Timestamptz()
}

model LessonAttachment {
  id         String   @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  lessonId   String   @map("lesson_id") @db.Uuid
  fileName   String   @map("file_name") @db.VarChar(255)
  fileUrl    String   @map("file_url") @db.Text
  fileType   String   @map("file_type") @db.VarChar(50)
  fileSize   Int      @map("file_size")
  uploadedAt DateTime @default(now()) @map("uploaded_at") @db.Timestamptz()

  // Relations
  lesson Lesson @relation(fields: [lessonId], references: [id], onDelete: Cascade)

  @@map("lesson_attachments")
}

model LessonProgress {
  id          String               @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  lessonId    String               @map("lesson_id") @db.Uuid
  userId      String               @map("user_id") @db.Uuid
  status      LessonProgressStatus @default(not_started)
  startedAt   DateTime?            @map("started_at") @db.Timestamptz()
  completedAt DateTime?            @map("completed_at") @db.Timestamptz()
  progressPct Int                  @default(0) @map("progress_pct")

  // Relations
  lesson Lesson @relation(fields: [lessonId], references: [id], onDelete: Cascade)
  user   User   @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([lessonId, userId])
  @@map("lesson_progress")
}

model Attendance {
  id         String           @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  classId    String           @map("class_id") @db.Uuid
  userId     String           @map("user_id") @db.Uuid
  date       DateTime         @db.Date
  status     AttendanceStatus
  recordedBy String           @map("recorded_by") @db.Uuid
  notes      String?          @db.Text
  xpAwarded  Int              @default(0) @map("xp_awarded")
  createdAt  DateTime         @default(now()) @map("created_at") @db.Timestamptz()

  // Relations
  class    Class @relation(fields: [classId], references: [id], onDelete: Cascade)
  student  User  @relation("AttendanceStudent", fields: [userId], references: [id])
  recorder User  @relation("AttendanceRecorder", fields: [recordedBy], references: [id])

  @@unique([classId, userId, date])
  @@index([classId, date])
  @@index([userId])
  @@map("attendance")
}

model Task {
  id             String     @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  classId        String     @map("class_id") @db.Uuid
  lessonId       String?    @map("lesson_id") @db.Uuid
  title          String     @db.VarChar(300)
  description    String     @db.Text
  taskType       TaskType   @map("task_type")
  xpReward       Int        @default(30) @map("xp_reward")
  pointsReward   Int        @default(5) @map("points_reward")
  dueDate        DateTime?  @map("due_date") @db.Timestamptz()
  maxSubmissions Int        @default(1) @map("max_submissions")
  allowLate      Boolean    @default(false) @map("allow_late")
  status         TaskStatus @default(draft)
  createdBy      String     @map("created_by") @db.Uuid
  createdAt      DateTime   @default(now()) @map("created_at") @db.Timestamptz()
  updatedAt      DateTime   @default(now()) @updatedAt @map("updated_at") @db.Timestamptz()

  // Relations
  class       Class            @relation(fields: [classId], references: [id], onDelete: Cascade)
  lesson      Lesson?          @relation(fields: [lessonId], references: [id])
  creator     User             @relation("TaskCreator", fields: [createdBy], references: [id])
  submissions TaskSubmission[]

  @@map("tasks")
  deletedAt      DateTime? @map("deleted_at") @db.Timestamptz()
}

model TaskSubmission {
  id            String           @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  taskId        String           @map("task_id") @db.Uuid
  studentId     String           @map("student_id") @db.Uuid
  content       String?          @db.Text
  attachmentUrl String?          @map("attachment_url") @db.Text
  status        SubmissionStatus @default(pending)
  feedback      String?          @db.Text
  reviewedBy    String?          @map("reviewed_by") @db.Uuid
  reviewedAt    DateTime?        @map("reviewed_at") @db.Timestamptz()
  xpAwarded     Int              @default(0) @map("xp_awarded")
  pointsAwarded Int              @default(0) @map("points_awarded")
  submittedAt   DateTime         @default(now()) @map("submitted_at") @db.Timestamptz()
  attemptNumber Int              @default(1) @map("attempt_number")

  // Relations
  task     Task  @relation(fields: [taskId], references: [id], onDelete: Cascade)
  student  User  @relation("SubmissionStudent", fields: [studentId], references: [id])
  reviewer User? @relation("SubmissionReviewer", fields: [reviewedBy], references: [id])

  @@index([taskId])
  @@index([studentId])
  @@index([status])
  @@map("task_submissions")
}

model Quiz {
  id               String     @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  classId          String     @map("class_id") @db.Uuid
  lessonId         String?    @map("lesson_id") @db.Uuid
  title            String     @db.VarChar(300)
  description      String?    @db.Text
  quizType         QuizType   @map("quiz_type")
  timeLimitSeconds Int?       @map("time_limit_seconds")
  maxAttempts      Int        @default(3) @map("max_attempts")
  passingScore     Int        @default(70) @map("passing_score")
  xpReward         Int        @default(50) @map("xp_reward")
  pointsReward     Int        @default(10) @map("points_reward")
  shuffleQuestions Boolean    @default(true) @map("shuffle_questions")
  showAnswersAfter Boolean    @default(true) @map("show_answers_after")
  status           TaskStatus @default(draft)
  availableFrom    DateTime?  @map("available_from") @db.Timestamptz()
  availableUntil   DateTime?  @map("available_until") @db.Timestamptz()
  createdBy        String     @map("created_by") @db.Uuid
  createdAt        DateTime   @default(now()) @map("created_at") @db.Timestamptz()

  // Relations
  class     Class         @relation(fields: [classId], references: [id], onDelete: Cascade)
  lesson    Lesson?       @relation(fields: [lessonId], references: [id])
  creator   User          @relation("QuizCreator", fields: [createdBy], references: [id])
  questions Question[]
  attempts  QuizAttempt[]

  @@map("quizzes")
  deletedAt      DateTime? @map("deleted_at") @db.Timestamptz()
}

model Question {
  id               String       @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  quizId           String       @map("quiz_id") @db.Uuid
  questionType     QuestionType @map("question_type")
  questionText     String       @map("question_text") @db.Text
  questionImageUrl String?      @map("question_image_url") @db.Text
  bibleReference   String?      @map("bible_reference") @db.VarChar(100)
  pointsValue      Int          @default(10) @map("points_value")
  orderIndex       Int          @default(0) @map("order_index")
  explanation      String?      @db.Text

  // Relations
  quiz    Quiz     @relation(fields: [quizId], references: [id], onDelete: Cascade)
  answers Answer[]

  @@map("questions")
}

model Answer {
  id         String  @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  questionId String  @map("question_id") @db.Uuid
  answerText String  @map("answer_text") @db.Text
  isCorrect  Boolean @default(false) @map("is_correct")
  orderIndex Int     @default(0) @map("order_index")

  // Relations
  question Question @relation(fields: [questionId], references: [id], onDelete: Cascade)

  @@map("answers")
}

model QuizAttempt {
  id               String   @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  quizId           String   @map("quiz_id") @db.Uuid
  studentId        String   @map("student_id") @db.Uuid
  score            Int
  totalPossible    Int      @map("total_possible")
  percentage       Decimal  @db.Decimal(5, 2)
  passed           Boolean
  timeTakenSeconds Int?     @map("time_taken_seconds")
  answersSnapshot  Json     @map("answers_snapshot") @db.JsonB
  xpAwarded        Int      @default(0) @map("xp_awarded")
  pointsAwarded    Int      @default(0) @map("points_awarded")
  attemptNumber    Int      @map("attempt_number")
  startedAt        DateTime @map("started_at") @db.Timestamptz()
  completedAt      DateTime @map("completed_at") @db.Timestamptz()

  // Relations
  quiz    Quiz @relation(fields: [quizId], references: [id], onDelete: Cascade)
  student User @relation(fields: [studentId], references: [id])

  @@index([studentId, quizId])
  @@map("quiz_attempts")
}

model PointsTransaction {
  id          String       @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  userId      String       @map("user_id") @db.Uuid
  amount      Int
  type        PointsType
  source      PointsSource
  sourceId    String?      @map("source_id") @db.Uuid
  description String       @db.VarChar(500)
  awardedBy   String?      @map("awarded_by") @db.Uuid
  createdAt   DateTime     @default(now()) @map("created_at") @db.Timestamptz()

  // Relations
  user    User  @relation("PointsUser", fields: [userId], references: [id])
  awarder User? @relation("PointsAwarder", fields: [awardedBy], references: [id])

  @@index([userId])
  @@index([createdAt])
  @@index([source])
  @@map("points_transactions")
}

model Level {
  id          String  @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  levelNumber Int     @unique @map("level_number")
  title       String  @db.VarChar(100)
  titleAr     String? @map("title_ar") @db.VarChar(100)
  minXp       Int     @map("min_xp")
  maxXp       Int     @map("max_xp")
  iconUrl     String? @map("icon_url") @db.Text
  color       String? @db.VarChar(7)

  // Relations
  users User[]

  @@map("levels")
}

model Badge {
  id             String            @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  name           String            @db.VarChar(100)
  nameAr         String?           @map("name_ar") @db.VarChar(100)
  description    String            @db.Text
  descriptionAr  String?           @map("description_ar") @db.Text
  iconUrl        String            @map("icon_url") @db.Text
  category       BadgeCategory
  criteriaType   BadgeCriteriaType @map("criteria_type")
  criteriaValue  Int?              @map("criteria_value")
  criteriaConfig Json              @default("{}") @map("criteria_config") @db.JsonB
  xpBonus        Int               @default(0) @map("xp_bonus")
  pointsBonus    Int               @default(0) @map("points_bonus")
  rarity         BadgeRarity       @default(common)
  isActive       Boolean           @default(true) @map("is_active")
  createdAt      DateTime          @default(now()) @map("created_at") @db.Timestamptz()

  // Relations
  studentBadges StudentBadge[]

  @@map("badges")
}

model StudentBadge {
  id        String   @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  userId    String   @map("user_id") @db.Uuid
  badgeId   String   @map("badge_id") @db.Uuid
  earnedAt  DateTime @default(now()) @map("earned_at") @db.Timestamptz()
  displayed Boolean  @default(false)

  // Relations
  user  User  @relation(fields: [userId], references: [id], onDelete: Cascade)
  badge Badge @relation(fields: [badgeId], references: [id], onDelete: Cascade)

  @@unique([userId, badgeId])
  @@map("student_badges")
}

model LeaderboardEntry {
  id          String            @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  userId      String            @map("user_id") @db.Uuid
  classId     String?           @map("class_id") @db.Uuid
  period      LeaderboardPeriod
  periodStart DateTime          @map("period_start") @db.Date
  totalXp     Int               @default(0) @map("total_xp")
  rank        Int?
  rankChange  Int               @default(0) @map("rank_change")
  updatedAt   DateTime          @default(now()) @updatedAt @map("updated_at") @db.Timestamptz()

  // Relations
  user  User   @relation(fields: [userId], references: [id], onDelete: Cascade)
  class Class? @relation(fields: [classId], references: [id], onDelete: Cascade)

  @@unique([userId, classId, period, periodStart])
  @@index([classId, period, periodStart])
  @@map("leaderboard_entries")
}

model Announcement {
  id          String               @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  classId     String?              @map("class_id") @db.Uuid
  authorId    String               @map("author_id") @db.Uuid
  title       String               @db.VarChar(300)
  content     String               @db.Text
  priority    AnnouncementPriority @default(normal)
  isPinned    Boolean              @default(false) @map("is_pinned")
  publishedAt DateTime             @default(now()) @map("published_at") @db.Timestamptz()
  expiresAt   DateTime?            @map("expires_at") @db.Timestamptz()
  createdAt   DateTime             @default(now()) @map("created_at") @db.Timestamptz()

  // Relations
  class  Class? @relation(fields: [classId], references: [id], onDelete: Cascade)
  author User   @relation(fields: [authorId], references: [id])

  @@map("announcements")
  deletedAt      DateTime? @map("deleted_at") @db.Timestamptz()
}

model ActivityLog {
  id           String   @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  userId       String   @map("user_id") @db.Uuid
  action       String   @db.VarChar(100)
  entityType   String   @map("entity_type") @db.VarChar(50)
  entityId     String?  @map("entity_id") @db.Uuid
  metadata     Json     @default("{}") @db.JsonB
  xpChange     Int      @default(0) @map("xp_change")
  pointsChange Int      @default(0) @map("points_change")
  createdAt    DateTime @default(now()) @map("created_at") @db.Timestamptz()

  // Relations
  user User @relation(fields: [userId], references: [id])

  @@index([userId, createdAt(sort: Desc)])
  @@map("activity_log")
}

// ============================================
// Phase 2 & 3 Additions
// ============================================

enum PrayerRequestType {
  prayer
  thanksgiving
}

enum RewardType {
  digital
  physical
}

enum RedemptionStatus {
  pending
  approved
  rejected
  fulfilled
}

enum ChallengeScope {
  daily
  weekly
  seasonal
}

enum NotificationChannel {
  inapp
  push
  email
}

enum GameType {
  quiz
  verse_builder
  memory_match
  treasure_hunt
  bible_adventure
}

enum GameSessionStatus {
  active
  paused
  completed
  abandoned
}

model PrayerRequest {
  id          String            @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  studentId   String            @map("student_id") @db.Uuid
  classId     String?           @map("class_id") @db.Uuid
  type        PrayerRequestType
  title       String?           @db.VarChar(200)
  body        String            @db.Text
  isPrivate   Boolean           @default(false) @map("is_private")
  isAddressed Boolean           @default(false) @map("is_addressed")
  addressedBy String?           @map("addressed_by") @db.Uuid
  addressedAt DateTime?         @map("addressed_at") @db.Timestamptz()
  createdAt   DateTime          @default(now()) @map("created_at") @db.Timestamptz()
